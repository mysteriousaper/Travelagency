---
import '../styles/global.css';
import ContactFields from '../components/ContactFields.astro';
import { site, tours } from '../lib/content.js';
import { buildRates } from '../lib/build-rates.js';
import { LOCALES, LOCALE_SHORT, SWITCH_ORDER, LOCALE_NAMES, makeT, pick, href, switchLocale, whatsappLink, telegramLink, telHref, mainBranch } from '../lib/i18n.js';

const { lang, title, description, current = '' } = Astro.props;
const t = makeT(lang);
const path = Astro.url.pathname;
const wa = whatsappLink();
const tg = telegramLink();
const main = mainBranch();
const mainPhone = main.phones[0];

// Rates come from the Central Bank of Armenia via /api/rates (see src/lib/cba.js).
const currencies = [['AMD', '֏'], ['USD', '$'], ['EUR', '€'], ['RUB', '₽']];
const fallbackRates = await buildRates();

const nav = [
  ['home', '', t('nav.home')],
  ['tours', 'tours', t('nav.tours')],
  ['visas', 'visas', t('nav.visas')],
  ['flights', 'flights', t('nav.flights')],
  ['contact', 'contact', t('nav.contact')],
];
const seaTours = tours.filter((x) => x.region === 'sea' || x.region === 'gulf');
const euTours = tours.filter((x) => x.region === 'europe' || x.region === 'caucasus');
const social = Object.entries(site.social ?? {}).filter(([, url]) => url);
const socialNames = { instagram: 'Instagram', facebook: 'Facebook', tiktok: 'TikTok', telegram: 'Telegram', youtube: 'YouTube' };
const hotels = ['3★', '4★', '5★'];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLocale(path, l), Astro.site)} />)}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={`https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+Armenian:wght@400;600;700${lang === 'hy' ? '&family=Noto+Serif+Armenian:wght@400;700' : ''}&display=swap`} rel="stylesheet" />
</head>
<body
  data-lang={lang}
  data-fallback-href={telHref(mainPhone)}
  data-fallback-wa={wa ?? ''}
  data-msg-whatsapp={t('form.send_whatsapp')}
  data-fallback-label={mainPhone}
  data-msg-sending={t('form.sending')}
  data-msg-ok={t('form.ok')}
  data-msg-error={t('form.error')}
  data-msg-invalid={t('form.invalid')}
>
  <script type="application/json" id="rates-fallback" set:html={JSON.stringify(fallbackRates)} />
  <div class="masthead">
  <div class="topbar">
    <div class="container">
      <div class="topbar-group">
        {main.phones.slice(0, 2).map((p, i) => <a href={telHref(p)} class={i > 0 ? 'hide-sm' : ''}>{p}</a>)}
        <span class="hide-sm">{pick(main.address, lang)}</span>
      </div>
      <div class="topbar-group">
        {wa && <a href={wa}>WhatsApp</a>}
        {tg && <a href={tg} rel="noopener" target="_blank">Telegram</a>}
        <span class="sep" aria-hidden="true">|</span>
        <div class="switch" role="group" aria-label={t('nav.currency')} data-currency-switch>
          {currencies.map(([code, sym]) => <button type="button" data-currency={code} aria-pressed="false" aria-label={code} disabled>{sym}</button>)}
        </div>
      </div>
    </div>
  </div>

  <header class="header">
    <div class="container">
      <a href={href(lang)} class="logo">
        <img src="/images/logo.png" alt="King Travel" width="140" height="50" />
      </a>
      <nav class="nav" id="main-nav" aria-label={t('nav.menu')}>
        {nav.map(([key, p, label]) => <a href={href(lang, p)} aria-current={current === key ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <nav class="lang" aria-label={t('nav.language')}>
          <svg class="lang-globe" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" /></svg>
          {SWITCH_ORDER.map((l) => <a href={switchLocale(path, l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={LOCALE_NAMES[l]}>{LOCALE_SHORT[l]}</a>)}
        </nav>
        <button type="button" class="menu-toggle" aria-controls="main-nav" aria-expanded="false" aria-label={t('nav.menu')} data-menu-toggle><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
        <button type="button" class="btn btn-amber header-cta" data-open-dialog="quote">{t('cta.plan')}</button>
      </div>
    </div>
  </header>
  </div>

  <main class="container">
    <slot />
  </main>

  <footer class="footer container">
    <div class="footer-inner">
      <div class="footer-top">
        <div class="footer-news">
          <img src="/images/logo-light.png" alt="King Travel" width="168" height="60" class="footer-logo" loading="lazy" />
          <h2>{t('footer.newsletter')}</h2>
          <form data-lead="newsletter" novalidate>
            <label class="visually-hidden" for="newsletter-email">{t('field.email_required')}</label>
            <input id="newsletter-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
            <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button type="submit" class="btn btn-amber">{t('footer.subscribe')}</button>
          </form>
          <p class="form-status" data-status role="status" aria-live="polite"></p>
        </div>
        <div class="footer-cols">
          <div>
            <strong>{t('hero.card_sea')}</strong>
            {seaTours.map((x) => <a href={href(lang, `tours/${x.slug}`)}>{pick(x.name, lang)}</a>)}
          </div>
          <div>
            <strong>{t('hero.card_europe')}</strong>
            {euTours.map((x) => <a href={href(lang, `tours/${x.slug}`)}>{pick(x.name, lang)}</a>)}
          </div>
          <div>
            <strong>{t('footer.services')}</strong>
            <a href={href(lang, 'visas')}>{t('nav.visas')}</a>
            <a href={href(lang, 'visas')}>{t('footer.insurance')}</a>
            <a href={href(lang, 'flights')}>{t('nav.flights')}</a>
            {site.social_packages_enabled && <a href={href(lang, 'contact')}>{t('social.label')}</a>}
            <a href={href(lang, 'contact')}>{t('nav.contact')}</a>
          </div>
          {social.length > 0 && (
            <div>
              <strong>{t('footer.follow')}</strong>
              {social.map(([k, url]) => <a href={url} rel="noopener" target="_blank">{socialNames[k] ?? k}</a>)}
            </div>
          )}
        </div>
      </div>
      <div class="footer-bottom">
        <span>King Travel · {site.branches.map((b) => pick(b.address, lang)).join(' · ')} · {pick(main.hours, lang)}</span>
        <span>© {new Date().getFullYear()} King Travel</span>
      </div>
    </div>
  </footer>

  <aside class="widget" aria-label={t('widget.title')} data-widget>
    <div class="widget-title">{t('widget.title')}</div>
    <div class="widget-row">
      {wa && <a class="w-wa" href={wa}>WhatsApp</a>}
      {tg && <a class="w-tg" href={tg} rel="noopener" target="_blank">Telegram</a>}
      <a class="w-call" href={telHref(mainPhone)}>{t('widget.call')}</a>
    </div>
  </aside>

  <div class="print-sheet" id="print-sheet" aria-hidden="true">
    <div class="print-head">
      <img src="/images/logo.png" alt="King Travel" width="140" height="50" />
      <div class="print-date" data-print-date></div>
    </div>
    <h1>{t('visa.print_heading')}: <span data-print-country></span></h1>
    <p class="print-note">{t('visa.note')}</p>
    <ul class="print-list" data-print-list></ul>
    <div class="print-foot">
      <strong>{t('visa.print_questions')}</strong>
      {site.branches.map((b) => <div>{pick(b.address, lang)} · {b.phones.slice(0, 2).join(', ')}</div>)}
      <div>{pick(main.hours, lang)}</div>
    </div>
  </div>

  <dialog class="quote-dialog" id="quote-dialog" aria-labelledby="quote-dialog-title">
    <form class="dialog-body" data-lead="quote" novalidate>
      <div class="dialog-head">
        <h2 id="quote-dialog-title">
          <span data-title-for="quote">{t('form.dialog_quote')}</span>
          <span data-title-for="visa" hidden>{t('form.dialog_visa')}</span>
          <span data-title-for="booking" hidden>{t('form.dialog_booking')}</span>
          <span data-title-for="callback" hidden>{t('form.dialog_callback')}</span>
          <span data-title-for="flight" hidden>{t('form.dialog_flight')}</span>
        </h2>
        <button type="button" class="icon-btn" data-close-dialog aria-label={t('form.close')}>×</button>
      </div>
      <p class="muted" style="margin: 0; font-weight: 700" data-context-text hidden></p>
      <input type="hidden" name="context" data-detail="Request" />
      <div data-only="quote" class="stack" style="gap: 10px">
        <div class="fields">
          <label class="field">{t.caps('field.destination')}
            <select name="destination" data-detail="Destination">
              {tours.map((x) => <option value={pick(x.name, 'en')}>{pick(x.name, lang)}</option>)}
              <option value="Other">{t('field.other')}</option>
            </select>
          </label>
          <label class="field">{t.caps('field.depart')}<input type="date" name="depart" data-detail="Leave" /></label>
          <label class="field">{t.caps('field.return')}<input type="date" name="return" data-detail="Come back" /></label>
        </div>
        <fieldset class="chips" data-chips="hotel">
          <legend>{t('field.hotel')}</legend>
          {hotels.map((h) => <button type="button" class="chip" data-value={h} aria-pressed={h === '4★' ? 'true' : 'false'}>{h}</button>)}
          <input type="hidden" name="hotel" value="4★" data-detail="Hotel" />
        </fieldset>
      </div>
      <label class="field" data-only="quote visa booking flight">{t.caps('field.notes')}<textarea name="notes" rows="3" maxlength="500" data-detail="Notes"></textarea></label>
      <ContactFields lang={lang} />
      <button type="submit" class="btn btn-amber btn-block">{t('form.send')}</button>
      <p class="search-note">{t('search.free_note')}</p>
    </form>
  </dialog>

  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
