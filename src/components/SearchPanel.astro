---
import ContactFields from './ContactFields.astro';
import { tours, visas } from '../lib/content.js';
import { makeT, pick, monthNames } from '../lib/i18n.js';

const { lang } = Astro.props;
const t = makeT(lang);
const months = monthNames(lang);
const travellers = t('field.travellers_options');
const hotels = ['4★', '3★', '5★'];
const tabs = [
  ['tours', t('search.tab_tours')],
  ['visa', t('search.tab_visa')],
  ['flights', t('search.tab_flights')],
];
---
<div class="search">
  <div class="tablist" role="tablist" aria-label={t('search.label')} data-tabs>
    {tabs.map(([id, label], i) => (
      <button type="button" role="tab" id={`tab-${id}`} aria-controls={`panel-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{label}</button>
    ))}
  </div>

  <form id="panel-tours" role="tabpanel" aria-labelledby="tab-tours" data-lead="quote" novalidate>
    <div class="fields">
      <label class="field">{t('field.destination')}
        <select name="destination" data-detail="Destination">
          {tours.map((x) => <option value={pick(x.name, 'en')}>{pick(x.name, lang)}</option>)}
          <option value="Other">{t('field.other')}</option>
        </select>
      </label>
      <label class="field">{t('field.month')}
        <select name="month" data-detail="Month">
          <option>{t('field.not_sure')}</option>
          {months.map((m) => <option>{m}</option>)}
        </select>
      </label>
      <label class="field">{t('field.travellers')}
        <select name="travellers" data-detail="Travellers">{travellers.map((o) => <option>{o}</option>)}</select>
      </label>
      <label class="field">{t('field.hotel')}
        <select name="hotel" data-detail="Hotel">{hotels.map((o) => <option>{o}</option>)}</select>
      </label>
    </div>
    <ContactFields lang={lang} />
    <button type="submit" class="btn btn-navy btn-block">{t('search.submit_tours')}</button>
  </form>

  <form id="panel-visa" role="tabpanel" aria-labelledby="tab-visa" data-lead="visa" novalidate hidden>
    <div class="fields">
      <label class="field">{t('field.country')}
        <select name="country" data-detail="Visa for">{visas.map((v) => <option value={pick(v.name, 'en')}>{pick(v.name, lang)}</option>)}</select>
      </label>
      <label class="field">{t('field.purpose')}
        <select name="purpose" data-detail="Purpose">{t('field.purpose_options').map((o) => <option>{o}</option>)}</select>
      </label>
      <label class="field">{t('field.work')}
        <select name="work" data-detail="Work">{t('field.work_options').map((o) => <option>{o}</option>)}</select>
      </label>
      <label class="field">{t('field.month')}
        <select name="month" data-detail="Travel month">
          <option>{t('field.not_sure')}</option>
          {months.map((m) => <option>{m}</option>)}
        </select>
      </label>
    </div>
    <ContactFields lang={lang} />
    <button type="submit" class="btn btn-navy btn-block">{t('search.submit_visa')}</button>
  </form>

  <form id="panel-flights" role="tabpanel" aria-labelledby="tab-flights" data-lead="flight" novalidate hidden>
    <div class="fields">
      <label class="field">{t('field.from')}<input name="from" value="Yerevan (EVN)" data-detail="From" maxlength="60" /></label>
      <label class="field">{t('field.to')}
        <select name="to" data-detail="To">
          {tours.map((x) => <option value={`${pick(x.name, 'en')} (${x.code})`}>{pick(x.name, lang)} ({x.code})</option>)}
          <option value="Other">{t('field.other')}</option>
        </select>
      </label>
      <label class="field">{t('field.depart')}<input type="date" name="depart" data-detail="Leave" /></label>
      <label class="field">{t('field.return')}<input type="date" name="return" data-detail="Come back" /></label>
      <label class="field">{t('field.passengers')}
        <select name="passengers" data-detail="Passengers">{travellers.map((o) => <option>{o}</option>)}</select>
      </label>
    </div>
    <ContactFields lang={lang} />
    <button type="submit" class="btn btn-navy btn-block">{t('search.submit_flights')}</button>
  </form>
  <p class="search-note">{t('search.free_note')}</p>
</div>
