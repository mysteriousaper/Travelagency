---
import Price from './Price.astro';
import { tours } from '../lib/content.js';
import { makeT, pick, href, whatsappLink } from '../lib/i18n.js';
import { fromPrice, offersOf } from '../lib/price.js';

const { lang, headingLevel = 'h2', showHeading = true } = Astro.props;
const t = makeT(lang);
const Heading = headingLevel;
const tagsOf = (tour) => [tour.kind, tour.visa_free && 'visa-free'].filter(Boolean);
// A filter only shows up when it narrows the list: it must match some tours but not all of them.
const filters = [
  ['all', t('tours.all')],
  ['beach', t('tours.filter_beach')],
  ['city', t('tours.filter_city')],
  ['visa-free', t('tours.filter_visa_free')],
].filter(([key]) => {
  if (key === 'all') return true;
  const n = tours.filter((x) => tagsOf(x).includes(key)).length;
  return n > 0 && n < tours.length;
});
---
<div data-filter-root>
  <div class="section-head">
    {showHeading && <Heading class="section-title">{t('tours.title')}<br /><span>{t('tours.subtitle')}</span></Heading>}
    <div class="filters" role="group" aria-label={t('tours.title')}>
      {filters.map(([key, label], i) => <button type="button" data-filter={key} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}
    </div>
  </div>
  <div class="tour-grid">
    {tours.map((tour) => {
      const name = pick(tour.name, lang);
      const wa = whatsappLink(`${name}: ${t('tours.request')}`);
      const price = fromPrice(tour);
      const first = offersOf(tour)[0];
      return (
        <article class="tour-card" data-tags={tagsOf(tour).join(' ')}>
          <a class="tour-card-img" href={href(lang, `tours/${tour.slug}`)} tabindex="-1" aria-hidden="true">
            {tour.image
              ? <img src={tour.image} alt="" loading="lazy" width="600" height="440" />
              : <div class="ph-box">[PLACEHOLDER: photo of {pick(tour.name, 'en')}]</div>}
          </a>
          <div class="tour-card-body">
            <div class="tour-card-title">
              <h3><a href={href(lang, `tours/${tour.slug}`)}>{name}</a></h3>
              <span class="muted" style="font-size: 13px">{pick(tour.country, lang)}</span>
            </div>
            {first && pick(first.title, lang) && <div class="muted" style="font-size: 13px">{pick(first.title, lang)}</div>}
            {price && <Price amount={price.amount} currency={price.currency} lang={lang} prefix={t('tours.from')} />}
            <div class="grow"></div>
            <div class="btn-row">
              {wa && <a class="btn btn-green" href={wa}>WhatsApp</a>}
              <button type="button" class="btn btn-navy" data-open-dialog="quote" data-destination={pick(tour.name, 'en')}>{t('tours.request')}</button>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</div>
