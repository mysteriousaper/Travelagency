---
import Base from '../../layouts/Base.astro';
import ContactFields from '../../components/ContactFields.astro';
import { tours } from '../../lib/content.js';
import { LOCALES, makeT, pick } from '../../lib/i18n.js';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = makeT(lang);
const travellers = t('field.travellers_options');
---
<Base lang={lang} title={`${t('flight.page_title')} · King Travel`} description={t('flight.page_lead')} current="flights">
  <div class="page-head">
    <h1>{t('flight.page_title')}</h1>
    <p>{t('flight.page_lead')}</p>
  </div>
  <div class="split">
    <form class="card stack" data-lead="flight" novalidate>
      <div class="fields">
        <label class="field">{t.caps('field.from')}<input name="from" value="Yerevan (EVN)" maxlength="60" data-detail="From" required /></label>
        <label class="field">{t.caps('field.to')}
          <input name="to" list="destinations" maxlength="60" data-detail="To" required />
          <datalist id="destinations">{tours.map((x) => <option value={`${pick(x.name, lang)} (${x.code})`} />)}</datalist>
        </label>
        <label class="field">{t.caps('field.depart')}<input type="date" name="depart" data-detail="Leave" /></label>
        <label class="field">{t.caps('field.return')}<input type="date" name="return" data-detail="Come back" /></label>
        <label class="field">{t.caps('field.passengers')}
          <select name="passengers" data-detail="Passengers">{travellers.map((o) => <option>{o}</option>)}</select>
        </label>
      </div>
      <label class="field">{t.caps('field.notes')}<textarea name="notes" rows="3" maxlength="500" data-detail="Notes"></textarea></label>
      <ContactFields lang={lang} />
      <button type="submit" class="btn btn-amber">{t('search.submit_flights')}</button>
      <p class="search-note">{t('search.free_note')}</p>
    </form>
    <div class="photo-tile" style="min-height: 420px">
      <img src="/images/flight.jpg" alt="" loading="lazy" />
    </div>
  </div>
</Base>
