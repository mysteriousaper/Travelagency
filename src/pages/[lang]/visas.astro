---
import Base from '../../layouts/Base.astro';
import VisaChecker from '../../components/VisaChecker.astro';
import ContactFields from '../../components/ContactFields.astro';
import Faq from '../../components/Faq.astro';
import { visas } from '../../lib/content.js';
import { LOCALES, makeT, pick, monthNames } from '../../lib/i18n.js';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = makeT(lang);
---
<Base lang={lang} title={`${t('visa.page_title')} · King Travel`} description={t('visa.page_lead')} current="visas">
  <div class="page-head">
    <h1>{t('visa.page_title')}</h1>
    <p>{t('visa.page_lead')}</p>
  </div>
  <div class="split">
    <VisaChecker lang={lang} />
    <form class="card stack" data-lead="visa" novalidate>
      <h2>{t('visa.book')}</h2>
      <div class="fields">
        <label class="field">{t('field.country')}
          <select name="country" data-detail="Visa for">{visas.map((v) => <option value={pick(v.name, 'en')}>{pick(v.name, lang)}</option>)}</select>
        </label>
        <label class="field">{t('field.purpose')}
          <select name="purpose" data-detail="Purpose">{t('field.purpose_options').map((o) => <option>{o}</option>)}</select>
        </label>
        <label class="field">{t('field.work')}
          <select name="work" data-detail="Work">{t('field.work_options').map((o) => <option>{o}</option>)}</select>
        </label>
        <label class="field">{t('field.month')}
          <select name="month" data-detail="Travel month"><option>{t('field.not_sure')}</option>{monthNames(lang).map((m) => <option>{m}</option>)}</select>
        </label>
      </div>
      <ContactFields lang={lang} />
      <button type="submit" class="btn btn-amber">{t('form.send')}</button>
    </form>
  </div>
  <div class="section"><Faq lang={lang} /></div>
</Base>
