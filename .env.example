# Copy this file to .env and fill it in. Never commit the real .env.

# Create a bot with @BotFather in Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=

# The chat that receives requests: your staff group or your own chat.
# Add the bot to the group, send any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_CHAT_ID=
