# Copy this file to add a destination. The file name (without .yaml) is not
# used; "slug" decides the page address, e.g. /en/tours/antalya/.
slug: example
order: 99            # lower numbers come first
kind: beach          # beach (sea holiday) | city (city trip)
visa_free: false     # true only if Armenian passport holders need no visa at all (visa on arrival = false)
code: XXX            # airport code shown on the card
image: ""            # e.g. /images/tours/example.jpg (put the file in public/images/tours/)
image_alt: { en: "", hy: "", ru: "" }
image_credit: ""        # photo credit, if the photo licence requires one
image_credit_url: ""
name: { en: "", hy: "", ru: "" }
country: { en: "", hy: "", ru: "" }
description: { en: "", hy: "", ru: "" }
flight: ""
visa: ""
best_months: ""
nights: ""           # optional, e.g. { en: "7 nights", hy: "7 գիշեր", ru: "7 ночей" }
includes: ""         # optional

# Offers with prices (optional). Without offers the tour shows "Price on request".
offers:
  - title: { en: "", hy: "", ru: "" }
    dates: { en: "", hy: "", ru: "" }     # optional
    hotel: ""                              # optional, e.g. "Nobel Gallery Hotel 4★"
    price: 145000                          # per person
    currency: AMD                          # AMD (default), USD, EUR or RUB
    # Pick from: flight, direct_flight, hotel, hotel_breakfast, breakfast,
    # all_inclusive, transfer, insurance (texts are in content/ui.yaml > includes)
    includes: [flight, hotel, breakfast]
    installments: true                     # shows the installment / PayLater line
