# Copy this file to add a destination. The file name (without .yaml) is not
# used; "slug" decides the page address, e.g. /en/tours/antalya/.
slug: example
order: 99            # lower numbers come first
region: sea          # sea (Red Sea) | gulf | europe
code: XXX            # airport code shown on the card
image: ""            # e.g. /images/tours/example.jpg (put the file in public/images/tours/)
image_alt: { en: "", hy: "", ru: "" }
image_credit: ""        # photo credit, if the photo licence requires one
image_credit_url: ""
name: { en: "", hy: "", ru: "" }
country: { en: "", hy: "", ru: "" }
description: { en: "", hy: "", ru: "" }
flight: ""
visa: ""
best_months: ""
nights: ""           # optional, e.g. { en: "7 nights", hy: "7 գիշեր", ru: "7 ночей" }
includes: ""         # optional
price_from_amd:      # a number like 450000, or leave empty for "Price on request"
